{
    "printWidth": 120,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "bracketSameLine": true,
    "arrowParens": "always",
    "objectWrap": "preserve",
    "proseWrap": "always",
    "htmlWhitespaceSensitivity": "strict",
    "singleAttributePerLine": true,
    "plugins": ["@zackad/prettier-plugin-twig"],
    "twigAlwaysBreakObjects": false
}
