<turbo-frame id="inventory-container">
    <div class="table-responsive" data-animate data-controller="item--items">
        <div class="items-toolbar mb-4">
            <a
                class="btn btn-dark me-3"
                href="{{ path('show_create_item', { id: inventory.id }) }}"
            >
                Create
            </a>
            <button
                class="btn btn-dark me-3"
                id="edit-btn"
                data-item--items-target="editBtn"
                disabled
            >
                Edit
            </button>
            <button
                class="btn btn-dark"
                id="delete-btn"
                data-item--items-target="deleteBtn"
                data-path="{{ path('delete_items', { id: inventory.id }) }}"
                disabled
            >
                Delete
            </button>
        </div>

        <div class="table-responsive">
            <table class="table">
                <thead>
                    <th></th>
                    <th>id</th>

                    <th>custom id</th>

                    <th>created At</th>
                    <th>created By</th>

                    {% for itemFieldName in itemFieldNames %}
                    <th>{{ itemFieldName }}</th>
                    {% endfor %}
                </thead>
                <tbody>
                    {% for item in pagination %}
                    <tr
                        data-edit-path="{{
                            path('show_update_item', { id: item.id })
                        }}"
                    >
                        <td style="width: 20px">
                            <input
                                class="form-check-input"
                                type="checkbox"
                                data-id="{{ item.id }}"
                            />
                        </td>
                        <td>{{ item.id }}</td>

                        <td>{{ item.customId }}</td>

                        <td>{{ item.createdAt|date('d.m.Y H:i:s') }}</td>
                        <td>{{ item.createdBy.email }}</td>

                        {% for itemSlot in itemSlots %}

                        <td>
                            {% if 'link' in itemSlot %}
                            <img
                                class="img-fluid"
                                src="{{ attribute(item, itemSlot) }}"
                            />
                            {% else %}
                            {{ attribute(item, itemSlot) }}
                            {% endif %}
                        </td>

                        {% endfor %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="pagination">
            {{ knp_pagination_render(pagination) }}
        </div>
    </div>
</turbo-frame>
