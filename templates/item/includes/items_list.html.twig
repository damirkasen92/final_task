<turbo-frame id="items_list">
<div class="table-responsive" data-animate>
    {% if pagination|length > 0 %}

        <div class="table-responsive">
            <table class="table">
                <thead>
                    <th></th>
                    <th>Custom id</th>
                    <th>Created At</th>
                    <th>Created By</th>

                    {% for itemFieldName in itemFieldNames %}
                        <th>{{ itemFieldName }}</th>
                    {% endfor %}
                </thead>
                <tbody>
                    {% for item in pagination %}
                        <tr data-edit-path="{{ path('show_update_item', { id: item.id }) }}">
                            <td style="width: 20px">
                                <input class="form-check-input" type="checkbox" data-id="{{ item.id }}" />
                            </td>
                            <td>{{ item.customId }}</td>
                            <td>{{ item.createdAt|date('d.m.Y H:i:s') }}</td>
                            <td>{{ item.createdBy.email }}</td>

                            {% for itemSlot in itemSlots %}

                                <td>
                                    {% if 'link' in itemSlot %}
                                        <img class="img-fluid" src="{{ attribute(item, itemSlot) }}" />
                                    {% else %}
                                        {{ attribute(item, itemSlot) }}
                                    {% endif %}
                                </td>

                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="pagination">
            {{ knp_pagination_render(pagination) }}
        </div>
    {% else %}

        <h2 class="text-center mt-3">
            {{ 'item.table.empty' | trans }}
        </h2>

    {% endif %}
</div>
</turbo-frame>
