<turbo-frame id="inventory-container">
    <div data-animate>
        <h2 class="my-3 text-center">Edit Inventory</h2>
        {{
            form_start(form, {
                action: path('update_inventory_settings', { id: inventory.id }),
                method: 'PATCH',
                attr: {
                    id: 'update-form',
                    'data-controller': 'inventory--update-inventory inventory--autosave',
                    'data-inventory--update-inventory-target': 'form',
                    'data-autosave-path': path('autosave_inventory_settings', {
                        id: inventory.id
                    })
                }
            })
        }}

        <div class="errors"></div>

        <div id="conflict"></div>

        {{ form_row(form.title) }}
        {{
            form_row(form.description, {
                attr: {
                    'data-controller': 'ui--markdown',
                    'data-ui--markdown-target': 'textarea',
                }
            })
        }}
        {{ form_row(form.category) }}

        <div class="mb-3">
            {{ form_label(form.imageUrl) }}

            <figure class="mb-3 {{ inventoryImage ? '' : 'visually-hidden' }}">
                <img src="{{ inventoryImage }}" alt="" class="img-fluid setting-image" />
                <figcaption>
                    {{ 'inventory.settings.picture' | trans }}
                </figcaption>
            </figure>

            <label class="btn btn-dark">
                <span>
                    {{ 'forms.upload_file' | trans }}
                </span>

                {{
                    form_widget(form.imageUrl, {
                        attr: {
                            id: 'file-input',
                            'data-controller': 'ui--file',
                            class: 'visually-hidden'
                        }
                    })
                }}
            </label>

            <span id="file-name" class="text-muted">{{ 'forms.file_not_selected' | trans }}</span>

            <div class="mt-2">
                <img id="preview" src="#" class="img-thumbnail" style="display: none; max-width: 200px" />
            </div>
        </div>

        {{ form_row(form.tags) }}

        {{ form_row(form._token) }}

        {{ form_end(form) }}
    </div>

    <script>
        window.conflictPath = "{{ path('resolve_inventory_conflict', {id: inventory.id}) }}";
    </script>

    <script id="translations" type="application/json">
        {{ {
            'inventory.update.successful': 'inventory.update.successful' | trans,
            'forms.submit': 'forms.submit' | trans,
            'conflict_resolve.title': 'conflict_resolve.title' | trans,
            'conflict_resolve.success': 'conflict_resolve.success' | trans,
            'conflict_resolve.description': 'conflict_resolve.description' | trans,
        }|json_encode|raw }}
    </script>
</turbo-frame>
