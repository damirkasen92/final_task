<li class="list-group-item">
    <span class="drag-handle">⇅</span>
    <div class="mb-3">
        {{ form_label(form.elements.vars.prototype.children.type) }}
        {{ form_widget(form.elements.vars.prototype.children.type)|e('html_attr') }}
    </div>
    <div class="mb-3">
        {{ form_label(form.elements.vars.prototype.children.value) }}
        <div class="input-group">
            {{ form_widget(form.elements.vars.prototype.children.value, {
                attr: {
                    'data-type': 'fixed'
                }
            })|e('html_attr') }}
            <span class="input-group-text" id="visible-addon"><i data-help class="bi bi-question-circle cursor-pointer"></i></span>
        </div>
    </div>
</li>
