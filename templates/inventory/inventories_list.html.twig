<turbo-frame id="inventories-list">
    <div data-animate>
        <table class="table">
            <thead>
                <tr>
                    <th>
                        <input
                            class="main-checkbox"
                            type="checkbox"
                            name="check"
                            data-controller="ui--checkbox"
                            data-action="click->ui--checkbox#click"
                        />
                    </th>
                    <th>{{ 'inventory.table.title' | trans }}</th>
                    <th>{{ 'inventory.table.category' | trans }}</th>
                    <th>{{ 'inventory.table.tags' | trans }}</th>
                    <th>{{ 'inventory.table.picture' | trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for inventory in inventories %}
                <tr>
                    <td>
                        <input
                            class="sub-checkbox"
                            type="checkbox"
                            name="check"
                            data-controller="ui--sub-checkbox"
                            data-action="click->ui--sub-checkbox#click"
                            data-id="{{ inventory.id }}"
                        />
                    </td>
                    <td>
                        <a
                            href="{{
                                path('show_inventory', { id: inventory.id })
                            }}"
                            target="_top"
                            >{{ inventory.title }}</a
                        >
                    </td>
                    <td>{{ inventory.category }}</td>
                    <td>
                        {% if (inventory.tags|length) > 0 %} {% for tag in
                        inventory.tags %}
                        {{ tag.name }}
                        <br />
                        {% endfor %} {% else %} - {% endif %}
                    </td>
                    <td>
                        {% if inventory.imageUrl %}
                        <img
                            src="{{ inventory.imageUrl }}"
                            alt=""
                            class="img-fluid object-fit-contain"
                        />
                        {% else %} - {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</turbo-frame>
