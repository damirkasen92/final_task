<!DOCTYPE html>
<html lang="{{ app.request.attributes.get('_locale') }}" data-bs-theme="light">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>
            {% block title %}
                Inventory webapp
            {% endblock %}
        </title>

        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.css" />

        <script src="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

        {% block stylesheets %}

        {% endblock %}
        {% block javascripts %}
            {% block importmap %}
                {{ importmap('app') }}
            {% endblock %}
        {% endblock %}
    </head>
    <body class="bg-body-tertiary" data-lang="{{ app.request.locale }}">
        <header class="header mb-4">
            <nav class="navbar navbar-expand-lg bg-body-tertiary">
                <div class="container">
                    <a class="navbar-brand" href="{{ path('home') }}">Inventories</a>
                    <button
                        class="navbar-toggler"
                        type="button"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#headerNavbar">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="offcanvas offcanvas-end" id="headerNavbar">
                        <div
                            class="navbar-wrapper d-flex flex-column-reverse flex-lg-row justify-content-end p-4 p-lg-0">
                            <ul class="navbar-nav">
                                <li class="nav-item">
                                    <a
                                        class="nav-link {{
                                        app.request.attributes.get('_route') == 'home'
                                            ? 'active'
                                            : ''
                                        }}"
                                        aria-current="page"
                                        href="{{ path('home') }}">
                                        {{ 'navbar.menu.home'|trans }}
                                    </a>
                                </li>

                                {% if is_granted(constant('App\\Enum\\UserRoles::ADMIN').value) %}
                                    <li class="nav-item">
                                        <a
                                            class="nav-link {{
                                            app.request.attributes.get('_route') == 'admin'
                                                ? 'active'
                                                : ''
                                            }}"
                                            aria-current="page"
                                            href="{{ path('admin') }}">
                                            {{ 'admin.title'|trans }}
                                        </a>
                                    </li>
                                {% endif %}
                                {% if not app.user %}
                                    <li class="nav-item">
                                        <a
                                            class="nav-link {{
                                            app.request.attributes.get('_route') == 'login'
                                                ? 'active'
                                                : ''
                                            }}"
                                            href="{{ path('login') }}">
                                            {{ 'navbar.menu.login'|trans }}
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a
                                            class="nav-link {{
                                            app.request.attributes.get('_route') == 'show_registration'
                                                ? 'active'
                                                : ''
                                            }}"
                                            href="{{ path('show_registration') }}">
                                            {{ 'navbar.menu.registration'|trans }}
                                        </a>
                                    </li>
                                {% else %}
                                    <li class="nav-item">
                                        <a
                                            class="nav-link {{
                                            app.request.attributes.get('_route') == 'inventories'
                                                ? 'active'
                                                : ''
                                            }}"
                                            href="{{ path('inventories') }}">
                                            {{ 'navbar.menu.inventories'|trans }}
                                        </a>
                                    </li>
                                    <li>
                                        <a
                                            class="nav-link {{
                                            app.request.attributes.get('_route') == 'show_user'
                                                ? 'active'
                                                : ''
                                            }}"
                                            href="{{ path('show_user', {id: app.user.id}) }}">
                                            {{ 'navbar.menu.user'|trans }}
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" href="{{ path('logout') }}">
                                            {{ 'navbar.menu.logout'|trans }}
                                        </a>
                                    </li>
                                {% endif %}
                            </ul>

                            <div class="d-flex mb-3 mb-lg-0">
                                <div class="dropdown me-2">
                                    <button
                                        class="btn btn-dark dropdown-toggle h-100"
                                        type="button"
                                        data-bs-toggle="dropdown">
                                        🌐
                                        {{ 'lang'|trans }}
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a
                                                class="dropdown-item"
                                                href="{{
                                                path(
                                                    'change_locale',
                                                    {
                                                        locale: 'en',
                                                        route: app.request.attributes.get('_route'),
                                                        params: app.request.attributes.get('_route_params'),
                                                        query: app.request.query.all()
                                                    }
                                                )
                                                }}">
                                                English
                                            </a>
                                        </li>
                                        <li>
                                            <a
                                                class="dropdown-item"
                                                href="{{
                                                path(
                                                    'change_locale',
                                                    {
                                                        locale: 'ru',
                                                        route: app.request.attributes.get('_route'),
                                                        params: app.request.attributes.get('_route_params'),
                                                        query: app.request.query.all()
                                                    }
                                                )
                                                }}">
                                                Русский
                                            </a>
                                        </li>
                                    </ul>
                                </div>

                                <button
                                    id="themeToggle"
                                    class="btn btn-dark"
                                    data-controller="ui--theme"
                                    data-action="click->ui--theme#change">
                                    <i class="bi bi-sun-fill" id="themeIcon"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </nav>
        </header>

        <div class="container">
            {% block body %}

            {% endblock %}
        </div>

        <footer class="mb-4"></footer>
    </body>
</html>
