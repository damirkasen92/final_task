<turbo-frame id="admin-table">
    <div data-animate>
        <table class="table">
            <thead>
                <tr>
                    <th>
                        <input class="main-checkbox" type="checkbox" name="check" data-controller="ui--checkbox" data-action="click->ui--checkbox#click" />
                    </th>
                    <th>{{ 'admin.table.header.name'|trans }}</th>
                    <th>{{ 'admin.table.header.email'|trans }}</th>
                    <th>{{ 'admin.table.header.role'|trans }}</th>
                    <th>{{ 'admin.table.header.blocked'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr>
                        <td>
                            <input class="sub-checkbox" type="checkbox" name="check" data-controller="ui--sub-checkbox" data-action="click->ui--sub-checkbox#click" data-id="{{ user.id }}" />
                        </td>
                        <td>{{ user.name }}</td>
                        <td>{{ user.email }}</td>
                        <td>
                            {% if role_admin in user.roles %}
                                {{ 'roles.admin'|trans }}
                            {% else %}
                                {{ 'roles.user'|trans }}
                            {% endif %}
                        </td>
                        <td>{{ user.blocked ? 'yes' : 'no' }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</turbo-frame>
